{
    "schemaVersion": 3,
    "namespace": "$DOCKER_NAMESPACE",
    "image": "$DOCKER_IMAGE",
    "context": ".",
    "dockerfile": "windows/Dockerfile",
    "runner": "windows-latest",
    "buildArgs": {
        "OS_BASE": "{{matrix.release}}"
    },
    "matrix": {
        "family": {
            "tags": {
                "windows": {
                    "aliases": [
                        "latest"
                    ],
                    "matrix": {
                        "release": {
                            "tags": {
                                "ltsc2019": {
                                    "buildArgs": {
                                        "BASE_IMAGE": "mcr.microsoft.com/windows:ltsc2019"
                                    }
                                },
                                "ltsc2022": {
                                    "buildArgs": {
                                        "BASE_IMAGE": "mcr.microsoft.com/windows/server:ltsc2022"
                                    }
                                }
                            }
                        }
                    }
                },
                "windowsservercore": {
                    "matrix": {
                        "release": {
                            "tags": {
                                "ltsc2019": {},
                                "ltsc2022": {}
                            }
                        }
                    },
                    "buildArgs": {
                        "BASE_IMAGE": "mcr.microsoft.com/windows/servercore:{{matrix.release}}"
                    }
                }
            }
        }
    }
}
